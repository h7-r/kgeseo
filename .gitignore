# ─────────────────────────────────────────────
#  깃이 추적하지 않을 것들
# ─────────────────────────────────────────────

# 의존성 — package.json 만 있으면 `npm install` 로 그대로 복원된다.
#   289MB 라서 올리면 clone 이 지옥이 되고, 운영체제마다 내용도 다르다.
node_modules/

# 빌드 결과물 — 소스에서 언제든 다시 만들어진다
dist/
dist-*/

# 배포 도구가 만드는 것
.vercel/

# 에디터 · 운영체제 찌꺼기
.DS_Store
.vscode/
.idea/
*.log
npm-debug.log*

# 손으로 만든 백업 — 이제 깃이 대신한다.
#   (당장 지우지는 않는다. 내 컴퓨터에는 남아 있고, 깃에만 안 올라간다)
src/*.backup*.jsx
src/*.backup*.css
_to_delete/

# 파이썬 바이트코드 캐시 — Blender 도구를 돌리면 생긴다
__pycache__/
*.pyc

# ── 저장소 안에서 굴러다니는 작업 산출물 ──────────────
#  깃에 올릴 것은 아니지만 **지우지도 않는다** — 내 컴퓨터에는 남는다.
#  이걸 안 적어 두면 `git status` 가 매번 수백 줄로 뒤덮여서
#  진짜 바뀐 소스가 묻힌다.
#
#  ※ output/ · outputs/ · 프로젝트파일/ 에는 정산신청서·인터뷰 대본·
#    발표자료 같은 **사업 서류**가 들어 있다. 실수로 지우지 말 것.
tmp/
output/
outputs/
undefined/
Claude outputs/
프로젝트파일/
public/references/
