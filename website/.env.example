# 이 파일을 .env 로 복사해 값을 채운다.

# 게임 본편 주소. 비어 있으면 게임 시작 단추가 게임 소개 화면으로 보낸다.
VITE_GAME_URL=

# 간편 로그인 클라이언트 ID. 키가 없으면 단추를 눌러도 창이 뜨지 않고 무엇이 없는지 화면에 알린다.

# Google — Google Identity Services credential 을 받아 백엔드가 검증한다.
# Google Cloud Console OAuth 클라이언트의 Authorized JavaScript origins 에 등록한다.
#   예: http://localhost:5175 · https://<실서비스 주소>
VITE_GOOGLE_CLIENT_ID=

# Naver — 인가 코드를 받은 뒤 토큰 교환과 프로필 확인은 백엔드가 한다.
# 네이버 개발자센터 Callback URL(과 백엔드 NAVER_REDIRECT_URI)에 등록한다.
#   예: http://localhost:5175/로그인/콜백 · https://<실서비스 주소>/로그인/콜백
VITE_NAVER_CLIENT_ID=

# "off" 면 테스트 계정을 만들지 않는다.
VITE_TEST_ACCOUNT=on
