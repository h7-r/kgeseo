# 이 파일을 .env 로 복사해 값을 채운다.

# 게임 본편 주소. 비어 있으면 게임 시작 단추가 게임 소개 화면으로 보낸다.
VITE_GAME_URL=

# 간편 로그인 클라이언트 ID. 앞단은 인가 코드 받기까지만 하고,
# 토큰 교환(client_secret 필요)은 반드시 서버에서 한다.
# 각 콘솔에 등록할 redirect_uri: http://localhost:5175/login/callback
VITE_GOOGLE_CLIENT_ID=
VITE_NAVER_CLIENT_ID=

# "off" 면 테스트 계정을 만들지 않는다.
VITE_TEST_ACCOUNT=on
