VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
# 배포 때 — 캐릭터 생성 「뒤로」가 돌아갈 웹사이트 주소
VITE_SITE_URL=https://example.com

# 배포 환경값 — 세 앱(웹사이트·본편·나주) 공통 규칙. 비워 두면 지금 개발 설정 그대로다. (shared/env.ts)
# 에셋 주소 — 끝에 / 없이. 예: https://assets.도메인  (비면 /models/… 같은 출처)
VITE_ASSET_BASE=
# 세션 값(asset_base_path)이 오기 전에 쓰는 케이스 버전 경로. 예: /c/naju-angam-01/v1  (VITE_ASSET_BASE 가 있을 때만 쓴다)
VITE_DEFAULT_CASE_PATH=
# 백엔드 출처 — 경로 없이, 끝에 / 없이. 예: https://api.도메인  (비면 같은 출처 /api proxy → 개발은 127.0.0.1:8000). 운영 빌드는 https 만
VITE_API_ORIGIN=
# 로비(Colyseus) 주소 — wss://…  (비면 로비 접속 끔 = 혼자 모드)
VITE_LOBBY_URL=
