# ═══════════════════════════════════════════════════════
# 간편 로그인 키 — 이 파일을 .env 로 복사하고 값을 채우세요.
#
# 키가 없으면 단추를 눌러도 창이 뜨지 않고, 무엇이 없는지 화면에 알려 줍니다.
# ═══════════════════════════════════════════════════════

# Google
# - Google Identity Services credential을 받아 Backend에 검증을 맡깁니다.
# - Google Cloud Console의 OAuth 클라이언트에 Authorized JavaScript origins를 등록하세요.
#   예: http://localhost:5175
#   예: https://<실서비스 주소>
VITE_GOOGLE_CLIENT_ID=

# Naver
# - 인가 코드를 받은 뒤 Backend가 토큰 교환과 프로필 확인을 처리합니다.
# - 네이버 개발자센터에 redirect/callback URL을 등록해야 합니다.
#   예: http://localhost:5175/로그인/콜백
#   예: https://<실서비스 주소>/로그인/콜백
VITE_NAVER_CLIENT_ID=
