# 실행 환경: development · test · production. 운영 서버는 반드시 production 이다 —
# 이 값으로만 운영 설정 검증(DB · 소셜 키 · HTTPS CORS · 쿠키 Secure) · API 문서(/docs) 차단 · 플레이 Origin 제한이 켜진다.
# 줄이 없으면 development 로 떠서 셋 다 꺼진 채 돈다
APP_ENV=development

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=waegok_app
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=waegok
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_REDIRECT_URI=http://localhost:5175/로그인/콜백

# 로그인 · 게스트 쿠키의 Secure(이름도 __Host- 로 바뀐다). 실제 서비스(https)에서는 true — production 은 true 가 아니면 시작되지 않는다
SESSION_COOKIE_SECURE=false
# 쿠키를 보내고 쓰기 요청을 할 수 있는 사이트(JSON 배열). 웹과 API 는 같은 사이트(예: www.도메인 · api.도메인)여야 한다
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# IP 기준 요청 빈도 제한(베타 전 보안 PR B). IP 하나가 RATE_LIMIT_WINDOW_SEC 초 안에 보낼 수 있는 요청 수, API 마다 따로 센다.
# 줄이 없으면 아래 기본값으로 켜진다. 0 · 음수 · 빈 값 · 숫자가 아니면 API 가 시작되지 않는다(제한을 끄는 값은 없다).
# 값은 시작할 때 한 번 읽는다. 바꾸면 waegok-api 재시작이 필요하다(코드 재배포는 필요 없다). 재시작하면 센 횟수는 비워진다.
# 운영 절차: backend/docs/deployment_login_readiness.md 「베타 전 보안 PR B」
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_EMAIL_EXISTS=30
RATE_LIMIT_NICKNAME_EXISTS=30
# 베타 30. 베타 종료 뒤 10 으로 낮출 예정
RATE_LIMIT_REGISTER=30
# 새 게스트를 만들 때만 센다(유효한 게스트 쿠키의 재사용은 세지 않는다)
RATE_LIMIT_ANONYMOUS_SESSION_CREATE=60
# 이메일 로그인(요청 빈도. 이메일 · IP 실패 잠금 15분과는 별개). 교실 하나가 같은 IP 라 가입보다 넉넉히
RATE_LIMIT_LOGIN=60
# 소셜 로그인 셋(/auth/google · /auth/naver · /auth/social-onboarding/complete). 값 하나를 셋이 같이 쓰고 API 마다 따로 센다
RATE_LIMIT_SOCIAL_LOGIN=30
# 베타 분석 기록(POST /api/v1/beta-events). 교실 하나가 같은 IP 로 나가므로 넉넉히
RATE_LIMIT_BETA_EVENTS=1500
# 1:1 문의 접수(POST /api/v1/inquiries) — 창이 따로 있다(기본 10분 5건)
RATE_LIMIT_INQUIRY_CREATE=5
RATE_LIMIT_INQUIRY_WINDOW_SEC=600

# 비밀번호 찾기(11/25, 계약 password_reset_v0.1) — IP 당 60초 한도. 코드 메일 · 코드 확인 · 새 비밀번호 저장을 따로 센다
RATE_LIMIT_PASSWORD_RESET_REQUEST=10
RATE_LIMIT_PASSWORD_RESET_VERIFY=30
RATE_LIMIT_PASSWORD_RESET_COMPLETE=30

# 메일 발송(비밀번호 찾기 코드). disabled = 보내지 않음(비밀번호 찾기는 503 mail_unavailable) ·
# console = 서버 로그에 코드를 적음(개발 전용 — production 이면 API 가 시작되지 않는다) · smtp = SMTP 서버로 보냄
MAIL_BACKEND=disabled
# 보내는 사람. 발송 서비스(AWS SES 등)에서 인증한 주소 · 도메인이어야 한다. 공백 · <> 가 있으니 큰따옴표로 감싼다
# 예: MAIL_FROM="왜곡 <no-reply@k-escape.com>"
MAIL_FROM=
# AWS SES 서울: email-smtp.ap-northeast-2.amazonaws.com · 587 · STARTTLS. 사용자 이름 · 비밀번호는 SES 「SMTP 자격 증명」 값
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 은 STARTTLS=true, 465 는 SSL=true. 둘 다 false 인 평문 발송은 production 에서 시작되지 않는다
SMTP_STARTTLS=true
SMTP_SSL=false
# 시험 발송 기간에 받을 수 있는 주소(쉼표로 구분). 비우면 누구에게나 보낸다. 값이 있으면 목록 밖 이메일의 비밀번호 찾기는 503(고객센터 안내)
# 처리방침 시행일(2026-12-04) 전에는 팀 계정만 넣고, 시행일에 비우고 재시작한다
MAIL_TEST_RECIPIENTS=
# 인증코드 해시에 섞는 서버 비밀값. 운영에서 MAIL_BACKEND=smtp 면 32자 이상 필수. 만들기: openssl rand -hex 32
PASSWORD_RESET_CODE_SECRET=

# 베타 분석 기록을 저장할지. false 면 받기만 하고 저장하지 않는다(응답 disabled: true — 게임은 그만 보낸다)
BETA_EVENTS_ENABLED=true

# 힌트 잔액(PM v0.4.8 · v0.4.9 §9). 회차 시작 잔액 · 회차당 재미 미니게임 수 · 특별 미니게임 수
HINT_INITIAL_BALANCE=3
HINT_FUN_MINIGAMES_PER_SESSION=2
HINT_SPECIAL_MINIGAMES_PER_SESSION=1
# hint_ref 발급 키(운영 비밀). 비어 있으면 hint_ref 를 발급하지 않는다(fail closed).
# 형식: HINT_REF_KEYS="<key id>:<base64url 비밀>[,<key id>:<base64url 비밀>...]" · HINT_REF_CURRENT_KEY_ID 는 그중 지금 쓰는 id
HINT_REF_CURRENT_KEY_ID=
HINT_REF_KEYS=

# 게시 콘텐츠 원본 루트(<root>/<case_id>/v<version>/*.json). 비어 있으면 서버 시작 때 게시본을 복구하지 않는다
PUBLISHED_CONTENT_ROOT=
# 공식 일반 대사 팩(<pack_id>/v<pack_version>, 예: general_default/v1). 비어 있으면 일반 팩을 공급하지 않는다
NPC_GENERAL_PACK=
