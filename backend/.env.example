DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=waegok_app
DB_PASSWORD=YOUR_PASSWORD
DB_NAME=waegok
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
NAVER_REDIRECT_URI=http://localhost:5175/로그인/콜백

# 로그인 쿠키. 실제 서비스(https)에서는 true
SESSION_COOKIE_SECURE=false
# 쿠키를 보내고 쓰기 요청을 할 수 있는 사이트(JSON 배열). 웹과 API 는 같은 사이트(예: www.도메인 · api.도메인)여야 한다
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://localhost:5175"]

# IP 기준 요청 빈도 제한(베타 전 보안 PR B). IP 하나가 RATE_LIMIT_WINDOW_SEC 초 안에 보낼 수 있는 요청 수, API 마다 따로 센다.
# 줄이 없으면 아래 기본값으로 켜진다. 0 · 음수 · 빈 값 · 숫자가 아니면 API 가 시작되지 않는다(제한을 끄는 값은 없다).
# 값은 시작할 때 한 번 읽는다. 바꾸면 waegok-api 재시작이 필요하다(코드 재배포는 필요 없다). 재시작하면 센 횟수는 비워진다.
# 운영 절차: backend/docs/deployment_login_readiness.md 「베타 전 보안 PR B」
RATE_LIMIT_WINDOW_SEC=60
RATE_LIMIT_EMAIL_EXISTS=30
RATE_LIMIT_NICKNAME_EXISTS=30
# 베타 30. 베타 종료 뒤 10 으로 낮출 예정
RATE_LIMIT_REGISTER=30
# 새 게스트를 만들 때만 센다(유효한 게스트 쿠키의 재사용은 세지 않는다)
RATE_LIMIT_ANONYMOUS_SESSION_CREATE=60
